rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net Catch-all (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Type Validation helpers
    function isValidQuiz(data) {
      return data.userId is string 
        && data.userId == request.auth.uid 
        && data.title is string 
        && data.title.size() <= 300
        && data.questions is list
        && data.questions.size() <= 200
        && data.createdAt == request.time;
    }

    function isValidPerformance(data) {
      return data.userId is string 
        && data.userId == request.auth.uid
        && data.quizId is string
        && data.quizId.size() <= 128
        && data.quizTitle is string
        && data.quizTitle.size() <= 300
        && data.score is int
        && data.score >= 0
        && data.totalQuestions is int
        && data.totalQuestions >= 0
        && data.score <= data.totalQuestions
        && data.mode is string
        && (data.mode == 'practice' || data.mode == 'exam')
        && data.timeTaken is int
        && data.timeTaken >= 0
        && data.createdAt == request.time;
    }

    // Quizzes collection
    match /quizzes/{quizId} {
      allow get: if isOwner(existing().userId);
      allow list: if isOwner(resource.data.userId);

      allow create: if isEmailVerified() 
        && isValidId(quizId) 
        && isValidQuiz(incoming())
        && (incoming().keys().hasAll(['userId', 'title', 'questions', 'createdAt']) && incoming().keys().size() == 4);

      allow update: if false; // Quizzes are immutable in our app
      allow delete: if isOwner(existing().userId);
    }

    // Performances collection
    match /performances/{performanceId} {
      allow get: if isOwner(existing().userId);
      allow list: if isOwner(resource.data.userId);

      allow create: if isEmailVerified()
        && isValidId(performanceId)
        && isValidPerformance(incoming())
        && (incoming().keys().hasAll(['userId', 'quizId', 'quizTitle', 'score', 'totalQuestions', 'mode', 'timeTaken', 'createdAt']) && incoming().keys().size() == 8)
        && exists(/databases/$(database)/documents/quizzes/$(incoming().quizId));

      allow update: if false; // Performances are immutable to prevent tampered scoring history
      allow delete: if isOwner(existing().userId);
    }
  }
}
